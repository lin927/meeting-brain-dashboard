{
  "name": "meeting-brain-dashboard",
  "version": "0.2.0",
  "description": "会议智能助手：本机同步钉钉/飞书/腾讯听记、独立 Web 界面、本地向量检索。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "public",
    "server",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "install:mac": "bash scripts/install.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.19.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT"
}
